{
  "name": "costimator",
  "version": "0.1.0",
  "description": "DPWH Integrated Cost Estimation System - Quantity Takeoff + UPA/DUPA + BOQ Management",
  "private": true,
  "scripts": {
    "predev": "node scripts/clear-next-lock.mjs",
    "predev:turbo": "node scripts/clear-next-lock.mjs",
    "predev:webpack": "node scripts/clear-next-lock.mjs",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "perf:audit": "node scripts/perf-audit.mjs",
    "seed": "node --import tsx scripts/seed.ts",
    "seed:pay-items": "node scripts/import-pay-items.mjs",
    "backfill:estimate-source": "node --import tsx scripts/backfill-cost-estimate-source.ts",
    "backfill:labor-version": "node --import tsx scripts/backfill-labor-version.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.8",
    "mongoose": "^9.7.3",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "node-fetch": "^2.7.0",
    "papaparse": "^5.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
